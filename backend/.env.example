# SYNAPSE - environment template
# Copy to .env and fill in real values:  cp .env.example .env
# .env is gitignored. Never commit real credentials.

# ---- Server ----
PORT=5000

# ---- Database (required) ----
# MongoDB Atlas SRV string. Get it from Atlas -> Database -> Drivers ->
# Connection String. Replace <password> with the database user's password
# (URL-encode special characters such as @ : / ? #).
MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/DeptCommunity?authSource=admin&retryWrites=true&w=majority

# Optional offline fallback, tried if MONGO_URI fails. Handy when the Atlas
# IP access list blocks your current network.
# MONGO_URI_LOCAL=mongodb://127.0.0.1:27017/DeptCommunity

# ---- Auth (required) ----
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The server refuses to start if this is missing.
JWT_SECRET=

# ---- CORS ----
# Comma-separated list of origins allowed to call the API. Only needed when
# the frontend is served from a different origin/port than the API; when both
# are on PORT above, requests are same-origin and this is ignored.
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# ---- Seeding (optional) ----
# Password for the admin account created by `npm run seed`. If unset, a strong
# random password is generated and printed once, so no usable default is
# stored in version control. Ignored if the account already exists.
# Minimum 8 characters.
# SEED_ADMIN_PASSWORD=

# Students are imported from studentSeedData.js (76 official accounts) and
# sign in with their registration number + roll number; there is no student
# password to configure here.
